{
  "name": "@aecomet/backoff-util",
  "version": "1.0.11",
  "description": "A utility to use retry any functions",
  "keywords": [
    "exponential backoff",
    "retry"
  ],
  "main": "dist/index.umd.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.umd.cjs"
      }
    }
  },
  "types": "dist/src/index.d.ts",
  "scripts": {
    "test": "vitest --config __tests__/vitest.config.mts run",
    "dev:html": "vite --config example/html/vite.config.mts",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aecomet/backoff-util"
  },
  "bugs": {
    "url": "https://github.com/aecomet/backoff-util/issues"
  },
  "homepage": "https://github.com/aecomet/backoff-util#readme",
  "author": "aecomet",
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^4.1.8",
    "axios": "^1.17.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "5.0.2",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.8"
  }
}
